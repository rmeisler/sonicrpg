  <object id="54" name="Trigger" type="TouchTrigger" gid="6839" x="160" y="1120" width="512" height="32">
   <properties>
    <property name="atMostOnce" type="bool" value="true"/>
    <property name="script">local BlockPlayer = require &quot;actions/BlockPlayer&quot;
local MessageBox = require &quot;actions/MessageBox&quot;
local Animate = require &quot;actions/Animate&quot;
local Do = require &quot;actions/Do&quot;
local Serial = require &quot;actions/Serial&quot;
local Parallel = require &quot;actions/Parallel&quot;
local Ease = require &quot;actions/Ease&quot;
local Wait = require &quot;actions/Wait&quot;
local AudioFade = require &quot;actions/AudioFade&quot;
local PlayAudio = require &quot;actions/PlayAudio&quot;

return function(self)
    walkout, walkin, sprites = self.scene.player:split(nil, true)
    for k in pairs(GameState.party) do
        sprites[k].x = self.scene.player.x - 60
        sprites[k].y = self.scene.player.y - 60
    end

    return BlockPlayer {
        walkout,
        Animate(sprites.b.sprite, &quot;idleup&quot;),
        Animate(sprites.babyt.sprite, &quot;idleup&quot;),
        Animate(sprites.tails.sprite, &quot;idleup&quot;),
        Wait(1),

        Parallel {
            sprites.babyt:hop(),
            MessageBox{message=&quot;Baby T: Whoah!... {p60}Is that like a grown-up Tails?...&quot;}
        },
        MessageBox{message=&quot;Tails: No way...&quot;},
        Wait(1),
        Parallel {
            Ease(self.scene.objectLookup.EpochTails.sprite.color, 1, 255, 0.5),
            Ease(self.scene.objectLookup.EpochTails.sprite.color, 2, 255, 0.5),
            Ease(self.scene.objectLookup.EpochTails.sprite.color, 3, 255, 0.5)
        },
        MessageBox{message=&quot;Miles: The War Claws destroyed everything during the Great War...&quot;},
        MessageBox{message=&quot;Miles: I was told that, after the King caught Mobotropolis' War Minister {h Julian Kintobor} plotting against\nthe kingdom, he was banished...&quot;},
        MessageBox{message=&quot;Miles: It was then that the now former War Minister made a deal with the {h War Claws}...&quot;},
        MessageBox{message=&quot;Miles: The War Claws, however, rejected Julian's 'roboticization' plan. {p80}They thought it put too much trust\nin the efficacy of mind control technology.&quot;},
        MessageBox{message=&quot;Miles: After all, if they failed to curb free will, it would then mean thousands of angry, super strong, roboticized citizenry to deal with...&quot;},
        MessageBox{message=&quot;Miles: So in exchange for his amnesty, Julian would instead build them a bomb. {p60}A very, {p60}very {p60}powerful bomb... {p80}to be used on Mobotropolis.&quot;},
        Parallel { 
            sprites.tails:hop(),
            MessageBox{message=&quot;Tails: What!? {p60}That's not how it happened!&quot;}
        },
        MessageBox{message=&quot;Miles: I wish that the King never learned of Julian's betrayal... {p60}Julian at least had the power to win the Great War for Mobotropolis.&quot;},
        MessageBox{message=&quot;Miles: After that? {p60}Sure maybe most of us would be roboticized, but at least we'd have a chance. {p60}Maybe some of us could resist the mind control, like the War Claws feared...&quot;},
        Parallel {
            sprites.tails:hop(),
            MessageBox{message=&quot;Tails: You wish that Robotnik took over?! {p60}That's what I'm trying to prevent!!&quot;}
        },
        Ease(self.scene.objectLookup.EpochTails.sprite.color, 4, 0, 0.5),
        Animate(sprites.tails.sprite, &quot;saddown&quot;),
        MessageBox{message=&quot;Tails: ...{p60}is this what happens if I get my wish?...&quot;},
        Animate(sprites.babyt.sprite, &quot;idleleft&quot;),
        MessageBox{message=&quot;Baby T: It's probably just another trial, Tails! {p60}Just testing our resolve, right?&quot;},
        Animate(sprites.b.sprite, &quot;pose&quot;),
        MessageBox{message=&quot;B: ...&quot;},
        Do(function() self.scene.objectLookup.EpochTails:permanentRemove() end),

        walkin
    }
end</property>
   </properties>
