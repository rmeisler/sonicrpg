    <property name="onInteract">local BlockPlayer = require &quot;actions/BlockPlayer&quot;
local MessageBox = require &quot;actions/MessageBox&quot;
local Animate = require &quot;actions/Animate&quot;
local Do = require &quot;actions/Do&quot;
local Serial = require &quot;actions/Serial&quot;
local Parallel = require &quot;actions/Parallel&quot;
local Ease = require &quot;actions/Ease&quot;

return function(self)
    local walkout, walkin, sprites = self.scene.player:split(nil, true)
    for k in pairs(GameState.party) do
        sprites[k].x = scene.player.x - 100
        sprites[k].y = scene.player.y - 60
    end

    return BlockPlayer {
        walkout,
        Animate(sprites.tails.sprite, &quot;idleup&quot;),
        Animate(sprites.b.sprite, &quot;idleup&quot;),
        Animate(sprites.babyt.sprite, &quot;idleup&quot;),
        MessageBox{message=&quot;???: Why do you seek {h the Light}?&quot;},
        Animate(sprites.tails.sprite, &quot;shock&quot;),
        Animate(sprites.b.sprite, &quot;shock&quot;),
        Animate(sprites.babyt.sprite, &quot;shock&quot;),
        Parallel {
            sprites.tails:hop(),
            sprites.babyt:hop(),
            sprites.b:hop(),
        },
        MessageBox{message=&quot;Tails: ...Uhh...&quot;},
        Animate(sprites.tails.sprite, &quot;idleup&quot;),
        Animate(sprites.b.sprite, &quot;idleup&quot;),
        Animate(sprites.babyt.sprite, &quot;idleup&quot;),
        MessageBox{message=&quot;Tails: W-Well, I wanna wish Robotnik gone for good!&quot;},
        MessageBox{message=&quot;???: The Light does not grant such wishes.&quot;},
        sprites.tails:hop(),
        MessageBox{message=&quot;Tails: Oh right--{p60} well I mean I was gonna wish that Robotnik never came to Mobotropolis!&quot;},
        MessageBox{message=&quot;???: You must prove yourselves worthy.&quot;},
        Parallel {
            Ease(self.sprite.color, 1, 255, 1),
            Ease(self.sprite.color, 2, 255, 1),
            Ease(self.sprite.color, 3, 255, 1)
        },
        Animate(self.sprite, &quot;reveal&quot;),
        self.scene:enterBattle{
            opponents = {&quot;golem&quot;},
            hint = &quot;after_battle&quot;,
            beforeBattle = Serial {
                walkin,
                Do(function()
                    self.scene.player.x = self.scene.player.x + 100
                    self.scene.player.y = self.scene.player.y + 60
                    local layer = self.scene:findLayer(&quot;above2&quot;)
                    layer.opacity = 0
                    self:permanentRemove()
                end),
            }
        }
    }
end</property>
