  <object id="54" name="Trigger" type="TouchTrigger" gid="6839" x="160" y="480" width="512" height="32">
   <properties>
    <property name="atMostOnce" type="bool" value="true"/>
    <property name="script">local BlockPlayer = require &quot;actions/BlockPlayer&quot;
local MessageBox = require &quot;actions/MessageBox&quot;
local Animate = require &quot;actions/Animate&quot;
local Do = require &quot;actions/Do&quot;
local Serial = require &quot;actions/Serial&quot;
local Parallel = require &quot;actions/Parallel&quot;
local Ease = require &quot;actions/Ease&quot;
local Wait = require &quot;actions/Wait&quot;
local AudioFade = require &quot;actions/AudioFade&quot;
local PlayAudio = require &quot;actions/PlayAudio&quot;
local Spawn = require &quot;actions/Spawn&quot;

local Transform = require &quot;util/Transform&quot;
local SpriteNode = require &quot;object/SpriteNode&quot;

return function(self)
    self.scene.player.x = 380
    walkout, walkin, sprites = self.scene.player:split(nil, true)
    for k in pairs(GameState.party) do
        sprites[k].x = self.scene.player.x - 60
        sprites[k].y = self.scene.player.y - 60
    end
    local storybook = SpriteNode(scene, Transform(0, 0, 1, 1), {255,255,255,0}, &quot;storybook3&quot;, nil, nil, &quot;ui&quot;)
    return BlockPlayer {
        AudioFade(&quot;music&quot;, 1, 0, 1),
        walkout,
        Do(function()
            sprites.b.x = sprites.b.x + 50
        end),
        Animate(sprites.b.sprite, &quot;idleright&quot;),
        Animate(sprites.babyt.sprite, &quot;idleleft&quot;),
        Animate(sprites.tails.sprite, &quot;reading&quot;),
        MessageBox{message=&quot;Tails: I think we're getting close...&quot;},
        Ease(storybook.color, 4, 255, 1),
        Wait(1),
        MessageBox{message=&quot;Tails: In the next part of the story, Ben and the Knight are approaching a bright light...&quot;},
        Ease(storybook.color, 4, 0, 1),

        PlayAudio(&quot;sfx&quot;, &quot;elevator&quot;, 1.0, true),
        Parallel {
            Serial {
                Wait(1),
                Animate(sprites.tails.sprite, &quot;idledown&quot;),
                Wait(1),
                MessageBox{message=&quot;Baby T: What is that?&quot;, closeAction=Wait(1.5)},
                MessageBox{message=&quot;Tails: Whatever it is{p60}, it sounds like it's coming closer!&quot;, closeAction=Wait(1.5)},
            },
            self.scene:screenShake(10, 30, 140)
        },
       -- Drill bursts onto scene
       PlayAudio(&quot;sfx&quot;, &quot;explosion&quot;, 1, true),
       self.scene:screenShake(25, 40),
       Ease(self.scene.objectLookup.Drill, &quot;x&quot;, function() return self.scene.objectLookup.Drill.x + 200 end, 5, &quot;quad&quot;),
       Animate(sprites.b.sprite, &quot;shock&quot;),
       Animate(sprites.babyt.sprite, &quot;shock&quot;),
       Animate(sprites.tails.sprite, &quot;shock&quot;),
       Parallel {
            sprites.b:hop(),
            sprites.babyt:hop(),
            sprites.tails:hop()
        },
        Wait(1),
        Parallel {
            Ease(self.scene.objectLookup.Drill, &quot;x&quot;, function() return self.scene.objectLookup.Drill.x - 250 end, 1),
            Ease(self.scene.camPos, &quot;y&quot;, function() return self.scene.camPos.y - 100 end, 1)
        },

        Animate(sprites.b.sprite, &quot;leap&quot;),
        Animate(sprites.babyt.sprite, &quot;idle&quot;),
        Animate(sprites.tails.sprite, &quot;leap&quot;),
        Parallel {
            Ease(sprites.babyt, &quot;y&quot;, function() return sprites.babyt.y + 30 end, 3),
            Ease(sprites.b, &quot;x&quot;, function() return sprites.babyt.x + 60 end, 3),
            Ease(sprites.tails, &quot;x&quot;, function() return sprites.babyt.x + 60 end, 3),
            Serial {
                Parallel {
                    Ease(sprites.b, &quot;y&quot;, function() return sprites.b.y - 50 end, 3),
                    Ease(sprites.tails, &quot;y&quot;, function() return sprites.tails.y - 50 end, 3)
                },
                Parallel {
                    Ease(sprites.b, &quot;y&quot;, function() return sprites.b.y + 200 end, 3),
                    Ease(sprites.tails, &quot;y&quot;, function() return sprites.tails.y + 130 end, 3)
                },
            }
       },
       Animate(sprites.b.sprite, &quot;crouch&quot;),
       Animate(sprites.tails.sprite, &quot;crouch&quot;),
       Wait(0.1),
       Animate(sprites.b.sprite, &quot;idle&quot;),
       Animate(sprites.tails.sprite, &quot;slap_idle&quot;),

        Wait(2),
        MessageBox{message=&quot;Well, well... {p60}what do we have here?&quot;, textSpeed=3},
        PlayAudio(&quot;music&quot;, &quot;robotnik&quot;, 1, true, true),

        Do(function() self.scene.objectLookup.Robotnik.sprite:setAnimation(&quot;walkright&quot;) end),
        Ease(self.scene.objectLookup.Robotnik, &quot;x&quot;, function() return self.scene.objectLookup.Robotnik.x + 260 end, 0.3, &quot;linear&quot;),
        Animate(self.scene.objectLookup.Robotnik.sprite, &quot;idleright&quot;),
        MessageBox{message=&quot;Tails: Robotnik!&quot;},
        MessageBox{message=&quot;Robotnik: Ah yes...{p40}you were the three I saw on the cliffs of the Great Jungle...&quot;, textSpeed=3},
        MessageBox{message=&quot;Robotnik: I gave you the pleasure of being the first victims of my latest creation...&quot;, textSpeed=3},
        Ease(self.scene.objectLookup.Terrabot, &quot;x&quot;, function() return self.scene.objectLookup.Terrabot.x + 130 end, 0.2),
        MessageBox{message=&quot;Robotnik: And here he is... {p60}truly a work of art, wouldn't you agree?&quot;, textSpeed=3},
        Parallel {
            Animate(sprites.babyt.sprite, &quot;roar&quot;),
            MessageBox{message=&quot;Baby T: You didn't create anything! {p60}That's my uncle!&quot;}
        },
        MessageBox{message=&quot;Robotnik: The little beast speaks...&quot;, textSpeed=2},
        MessageBox{message=&quot;Robotnik: You so narrowly survived your last encounter with the old boy...{p60} perhaps it's time for round\ntwo?&quot;, textSpeed=3},
        Do(function() self.scene.partySprites = sprites end),
        AudioFade(&quot;music&quot;, 1, 0, 1),
        self.scene:enterBattle {
            opponents = {&quot;terrabot2&quot;},
            initiative = &quot;cinematic&quot;,
            hint = &quot;after_terrabot&quot;,
            music = &quot;roboterrapod&quot;
        }
    }
end</property>
